---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Order Confirmed — The Garlic Father">
  <div class="result-page">
    <div class="check-icon">🧄</div>
    <h1 style="color:var(--green)">Order Confirmed!</h1>
    <p>Thank you for your order. You'll receive a confirmation email shortly.<br />Get ready for a garlickin' good time.</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center;">
      <a href="/#products" class="btn btn-primary">Shop More</a>
      <a href="/recipes" class="btn btn-outline">Browse Recipes</a>
    </div>
  </div>
</Layout>
