---
import Layout from '../../layouts/Layout.astro';

const recipes = [
  {
    name: 'Caramelised Shallot & Tomato Pasta',
    time: '30 mins', cals: '300–400 cal',
    desc: 'Slow-caramelised shallots and tomato simmered into a silky sauce, finished with a generous spoon of Garlico.',
    img: '/images/recipe-tomato-pasta.webp',
    href: 'https://garlico.webflow.io/recipes/caramelized-shallot-tomato-pasta-sauce',
    tag: 'Pasta',
  },
  {
    name: 'Garlic Bread',
    time: '20 mins', cals: '200–280 cal',
    desc: 'Crusty bread baked golden and loaded with rich, buttery Garlico garlic. The ultimate side.',
    img: '/images/recipe-garlic-bread.webp',
    href: 'https://garlico.webflow.io/recipes/garlic-bread',
    tag: 'Sides',
  },
  {
    name: 'Horopito & Garlic Marinated Chicken',
    time: '30–45 mins', cals: '350–450 cal',
    desc: 'Juicy chicken marinated in native horopito and garlic, then roasted sticky and golden.',
    img: '/images/recipe-marinated-chicken.webp',
    href: 'https://garlico.webflow.io/recipes/horopito-garlic-marinated-chicken',
    tag: 'Chicken',
  },
  {
    name: "Friday Night Pizza",
    time: '30–40 mins', cals: '300–400 cal',
    desc: "The Original Spice Girl's Friday-night pizza, built on a roasted-garlic base with all the trimmings.",
    img: '/images/recipe-friday-pizza.webp',
    href: 'https://garlico.webflow.io/recipes/the-original-spice-girls-friday-night-pizza',
    tag: 'Pizza',
  },
];
---
<Layout
  title="Recipes — The Garlic Father"
  description="Garlickin' good recipes using Garlico and Tahini. From pasta to pad thai, find your next favourite dish."
>
  <div class="page-hero">
    <h1>Recipes</h1>
    <p>Garlickin' good ideas for every night of the week.</p>
  </div>

  <div class="recipes-page-body">
    <div class="recipe-grid">
      {recipes.map(r => (
        <a href={r.href} class="recipe-card" target="_blank" rel="noopener">
          <div class="recipe-card-img">
            <img src={r.img} alt={r.name} loading="lazy" width="400" height="250" />
            <span style="position:absolute;top:12px;right:12px;background:var(--green);color:#fff;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:4px 10px;border-radius:99px;">
              {r.tag}
            </span>
          </div>
          <div class="recipe-card-body">
            <div class="recipe-meta">
              <span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {r.time}
              </span>
              <span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8h1a4 4 0 010 8h-1M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8zM6 1v3M10 1v3M14 1v3"/></svg>
                {r.cals}
              </span>
            </div>
            <div class="recipe-name">{r.name}</div>
            <div class="recipe-desc">{r.desc}</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
