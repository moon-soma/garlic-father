---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard';

const POUCH_PRICE = 1000; // $10.00 per 12 oz pouch
const POUCH_SIZE = '12 oz pouch';

const garlico = [
  {
    id: 'garlico-original',
    name: 'Garlico Original',
    flavor: 'original' as const,
    flavorLabel: 'Original',
    tagline: 'Freshly whipped garlic with lemon, olive oil & salt.',
    image: '/images/garlico-original.webp',
    price: POUCH_PRICE,
    size: POUCH_SIZE,
  },
  {
    id: 'garlico-spicy',
    name: 'Garlico Spicy',
    flavor: 'spicy' as const,
    flavorLabel: 'Spicy',
    tagline: 'The signature whip with a slow-building chili kick.',
    image: '/images/garlico-spicy.webp',
    price: POUCH_PRICE,
    size: POUCH_SIZE,
  },
  {
    id: 'garlico-tangy',
    name: 'Garlico Tangy',
    flavor: 'tangy' as const,
    flavorLabel: 'Tangy',
    tagline: 'Bright and zesty with an extra hit of fresh lemon.',
    image: '/images/garlico-tangy.webp',
    price: POUCH_PRICE,
    size: POUCH_SIZE,
  },
];

const recipes = [
  {
    name: 'Caramelised Shallot & Tomato Pasta',
    time: '30 mins',
    cals: '300–400 cal',
    desc: 'Slow-caramelised shallots and tomato simmered into a silky sauce, finished with a generous spoon of Garlico.',
    img: '/images/recipe-tomato-pasta.webp',
    href: 'https://garlico.webflow.io/recipes/caramelized-shallot-tomato-pasta-sauce',
  },
  {
    name: 'Garlic Bread',
    time: '20 mins',
    cals: '200–280 cal',
    desc: 'Crusty bread baked golden and loaded with rich, buttery Garlico garlic.',
    img: '/images/recipe-garlic-bread.webp',
    href: 'https://garlico.webflow.io/recipes/garlic-bread',
  },
  {
    name: 'Horopito & Garlic Marinated Chicken',
    time: '30–45 mins',
    cals: '350–450 cal',
    desc: 'Juicy chicken marinated in native horopito and garlic, then roasted sticky and golden.',
    img: '/images/recipe-marinated-chicken.webp',
    href: 'https://garlico.webflow.io/recipes/horopito-garlic-marinated-chicken',
  },
  {
    name: "Friday Night Pizza",
    time: '30–40 mins',
    cals: '300–400 cal',
    desc: "The Original Spice Girl's Friday-night pizza, built on a roasted-garlic base.",
    img: '/images/recipe-friday-pizza.webp',
    href: 'https://garlico.webflow.io/recipes/the-original-spice-girls-friday-night-pizza',
  },
];
---
<Layout title="The Garlic Father — Garlickin' Good">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-img-wrap">
      <img
        src="/images/hero.webp"
        alt="The Garlico lineup — Tangy, Original and Spicy freshly whipped garlic pouches"
        width="1600"
        height="1567"
        fetchpriority="high"
      />
    </div>
  </section>

  <!-- TAGLINE -->
  <section class="tagline-section">
    <h1>Garlickin' <span>Good</span></h1>
    <p>
      The Garlic Father has crafted a culinary revelation — the one and only Garlico.
      With its luscious purée of freshly whipped garlic, lemon, olive oil and salt,
      it's a symphony of flavour that elevates any dish, from Italian pasta to Indian
      curry to Mexican tacos. Get ready for a garlic-infused adventure.
    </p>
  </section>

  <!-- PRODUCTS -->
  <section class="products-section" id="products">
    <div class="products-inner">
      <span class="section-label">Our Products</span>
      <div class="section-title">Shop The Collection</div>
      <div class="product-grid">
        {garlico.map(p => <ProductCard client:load {...p} />)}
      </div>
    </div>
  </section>

  <!-- RECIPES -->
  <section class="recipes-section" id="recipes">
    <div class="recipes-inner">
      <div class="recipes-header">
        <div>
          <span class="section-label">Inspiration</span>
          <div class="section-title" style="margin-bottom:0">Featured Recipes</div>
        </div>
        <a href="/recipes" class="btn btn-outline">All Recipes →</a>
      </div>
      <div class="recipe-grid">
        {recipes.map(r => (
          <a href={r.href} class="recipe-card" target="_blank" rel="noopener">
            <div class="recipe-card-img">
              <img src={r.img} alt={r.name} loading="lazy" width="400" height="250" />
            </div>
            <div class="recipe-card-body">
              <div class="recipe-meta">
                <span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  {r.time}
                </span>
                <span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8h1a4 4 0 010 8h-1M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8zM6 1v3M10 1v3M14 1v3"/></svg>
                  {r.cals}
                </span>
              </div>
              <div class="recipe-name">{r.name}</div>
              <div class="recipe-desc">{r.desc}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>
